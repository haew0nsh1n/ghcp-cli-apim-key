# Deployment settings. Do not store keys, tokens, or passwords here.
AZURE_SUBSCRIPTION_ID="<subscription-id>"
AZURE_TENANT_ID="<tenant-id>"
AZURE_LOCATION=koreacentral
RESOURCE_PREFIX=ghcp-cli-apim-key
RESOURCE_GROUP_NAME=rg-ghcp-cli-apim-key
APIM_PUBLISHER_EMAIL=developer@example.com
APIM_PUBLISHER_NAME="Example Developer"

# Create this subscription separately with scripts/2_create_subscription_key.sh.
# CLI defaults to this subscription. Keys are retrieved from APIM at runtime.
APIM_SUBSCRIPTION_ID=dev-1

# Classic tiers only: Developer (development) or Premium (production).
APIM_SKU_NAME=Developer
OPENAI_MODEL_NAME=gpt-5-mini
OPENAI_MODEL_VERSION=2025-08-07
OPENAI_DEPLOYMENT_NAME=gpt-5-mini
OPENAI_DEPLOYMENT_SKU_NAME=GlobalStandard
OPENAI_DEPLOYMENT_CAPACITY=200
TOKENS_PER_MINUTE=200000
TOKEN_QUOTA=1000000
TOKEN_QUOTA_PERIOD=Monthly

# Optional settings for 1_create_self_hosted_gateway.sh.
# Defaults derive the names from APIM_NAME, which is an azd deployment output.
# SELF_HOSTED_GATEWAY_NAME=copilot-gateway
# SELF_HOSTED_GATEWAY_APP_NAME=copilot-gateway
# SELF_HOSTED_GATEWAY_ENV_NAME=copilot-gateway-env
# Pin an approved version or digest for production instead of the rolling v2 tag.
SELF_HOSTED_GATEWAY_IMAGE=mcr.microsoft.com/azure-api-management/gateway:v2

# Deployment outputs required by steps 1-3 are resolved from the current azd
# environment automatically. Do not set placeholders or empty values here:
# 0_azd_up.sh imports active settings and could overwrite real deployment outputs.
# For an existing deployment without azd outputs, uncomment and enter real names.
# APIM_NAME=copilotdemo-apim-<generated-suffix>
# OPENAI_ACCOUNT_NAME=copilotdemo-aoai-<generated-suffix>

# Optional CLI limits for 3_copilot_cli.sh; these are the script defaults.
# COPILOT_PROVIDER_MAX_PROMPT_TOKENS=32768
# COPILOT_PROVIDER_MAX_OUTPUT_TOKENS=4096
